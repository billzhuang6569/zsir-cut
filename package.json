{
  "name": "zsir-cut",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "validate:examples": "node scripts/validate-examples.ts",
    "fixtures:gen": "node fixtures/synth/cli.ts gen",
    "fixtures:bind": "node fixtures/synth/cli.ts bind",
    "fixtures:check": "node fixtures/synth/cli.ts check",
    "fixtures:relocate": "node fixtures/synth/cli.ts relocate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/node": "24.7.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
