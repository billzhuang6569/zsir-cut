{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/billzhuang6569/zsir-cut/schema/handoff-manifest.schema.json",
  "title": "zsir-cut handoff package manifest",
  "description": "See docs/spec/handoff-profile.md sections 3 and 6.",
  "type": "object",
  "required": ["schema", "schema_version", "export_id", "created_at", "project", "timeline_id", "source_revision", "profile", "exporter", "timebase", "options", "media", "files", "validation"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "zsir-cut/handoff-manifest" },
    "schema_version": { "const": "0.1" },
    "export_id": { "type": "string", "pattern": "^exp_[A-Za-z0-9_-]{1,64}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "project": {
      "type": "object",
      "required": ["id", "name", "path"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^prj_[A-Za-z0-9_-]{1,64}$" },
        "name": { "type": "string" },
        "path": { "type": "string" }
      }
    },
    "timeline_id": { "type": "string", "pattern": "^tl_[A-Za-z0-9_-]{1,64}$" },
    "source_revision": { "type": "string", "pattern": "^rev_[A-Za-z0-9_-]{1,64}$" },
    "profile": {
      "type": "object",
      "required": ["id", "host", "min_host_version", "format", "format_version"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "loss-report.schema.json#/$defs/profile" },
        "host": { "enum": ["final_cut_pro", "davinci_resolve", "premiere_pro"] },
        "min_host_version": { "type": "string" },
        "format": { "enum": ["fcpxml", "otio", "xmeml"] },
        "format_version": { "type": "string" }
      }
    },
    "exporter": {
      "type": "object",
      "required": ["version", "git_sha"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string" },
        "git_sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" }
      }
    },
    "timebase": {
      "type": "object",
      "required": ["edit_rate", "drop_frame", "start_timecode", "audio_rate", "duration"],
      "additionalProperties": false,
      "properties": {
        "edit_rate": { "type": "string", "pattern": "^[1-9][0-9]*(/[1-9][0-9]*)?$" },
        "drop_frame": { "type": "boolean" },
        "start_timecode": { "type": "string", "pattern": "^[0-9]{2}:[0-5][0-9]:[0-5][0-9][:;][0-9]{2}$" },
        "audio_rate": { "const": "48000" },
        "duration": { "type": "string", "pattern": "^[1-9][0-9]*(/[1-9][0-9]*)?s$" }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overlay": { "type": "boolean" },
        "subtitle_languages": { "type": "array", "items": { "type": "string" } },
        "accept_losses": { "type": "boolean" }
      }
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["media_id", "path", "size_bytes", "fingerprint", "online", "proxy_used"],
        "additionalProperties": false,
        "properties": {
          "media_id": { "type": "string", "pattern": "^med_[A-Za-z0-9_-]{1,64}$" },
          "path": { "type": "string", "description": "Absolute path written into the exchange file." },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "online": { "type": "boolean" },
          "proxy_used": { "type": "boolean" }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "role", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "description": "Relative to the package root." },
          "role": { "enum": ["timeline", "subtitle", "subtitle_words", "preview", "overlay", "loss_report", "readme"] },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "language": { "type": "string" }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["schema", "media_resolved", "host_import", "host_render_comparison"],
      "additionalProperties": false,
      "properties": {
        "schema": { "$ref": "#/$defs/check" },
        "media_resolved": { "$ref": "#/$defs/check" },
        "host_import": { "$ref": "#/$defs/check" },
        "host_render_comparison": { "$ref": "#/$defs/check" }
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["pass", "fail", "warn", "not_run"] },
        "at": { "type": "string", "format": "date-time" },
        "by": { "type": "string" },
        "host_version": { "type": "string" },
        "notes": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["check", "status"],
            "additionalProperties": false,
            "properties": {
              "check": { "type": "string" },
              "status": { "enum": ["pass", "fail", "warn", "not_run"] },
              "notes": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
