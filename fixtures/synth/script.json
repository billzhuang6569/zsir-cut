  "duration_ms": 120000,
  "sentences": [
    {
      "index": 0,
      "text": "大家好我是庄Sir",
      "en": "Hi everyone, I'm Zhuang Sir",
      "start_ms": 500,
      "end_ms": 2090,
      "first": 0,
      "last": 4
    },
    {
      "index": 1,
      "text": "今天聊聊zsir-cut这个项目",
      "en": "Today let's talk about zsir-cut",
      "start_ms": 5500,
      "end_ms": 7580,
      "first": 5,
      "last": 9
    },
    {
      "index": 2,
      "text": "它是剪辑师和Agent共用的时间线",
      "en": "A timeline shared by editors and agents",
      "start_ms": 10500,
      "end_ms": 13460,
      "first": 10,
      "last": 17
    },
    {
      "index": 3,
      "text": "Agent先把粗剪和字幕做完",
      "en": "The agent does the rough cut and captions first",
      "start_ms": 15500,
      "end_ms": 17800,
      "first": 18,
      "last": 24
    },
    {
      "index": 4,
      "text": "然后交给FinalCutPro收尾",
      "en": "Then hands off to Final Cut Pro",
      "start_ms": 20500,
      "end_ms": 22780,
      "first": 25,
      "last": 30
    },
    {
      "index": 5,
      "text": "也可以交给DaVinciResolve",
      "en": "Or to DaVinci Resolve",
      "start_ms": 25500,
      "end_ms": 27240,
      "first": 31,
      "last": 35
    },
    {
      "index": 6,
      "text": "一条三分钟的采访大概要剪两小时",
      "en": "A three-minute interview takes about two hours",
      "start_ms": 30500,
      "end_ms": 33800,
      "first": 36,
      "last": 45
    },
    {
      "index": 7,
      "text": "其中百分之六十的时间在找重复的话",
      "en": "Sixty percent of it is finding repeated lines",
      "start_ms": 35500,
      "end_ms": 39020,
      "first": 46,
      "last": 55
    },
    {
      "index": 8,
      "text": "我们希望把这部分交给Agent",
      "en": "We want the agent to take that part",
      "start_ms": 40500,
      "end_ms": 43020,
      "first": 56,
      "last": 62
    },
    {
      "index": 9,
      "text": "嗯就是说人只做判断",
      "en": "So people only make the calls",
      "start_ms": 45500,
      "end_ms": 47480,
      "first": 63,
      "last": 68
    },
    {
      "index": 10,
      "text": "字幕要跟着剪辑一起走",
      "en": "Captions must follow the edit",
      "start_ms": 50500,
      "end_ms": 52700,
      "first": 69,
      "last": 74
    },
    {
      "index": 11,
      "text": "删掉一句话字幕也跟着消失",
      "en": "Delete a line and its caption goes too",
      "start_ms": 55500,
      "end_ms": 58140,
      "first": 75,
      "last": 81
    },
    {
      "index": 12,
      "text": "品牌词比如zsir-cut不能写错",
      "en": "Brand names like zsir-cut must be right",
      "start_ms": 60500,
      "end_ms": 62800,
      "first": 82,
      "last": 87
    },
    {
      "index": 13,
      "text": "数字比如2026年10月也要对",
      "en": "Numbers like October 2026 must be right",
      "start_ms": 65500,
      "end_ms": 68120,
      "first": 88,
      "last": 96
    },
    {
      "index": 14,
      "text": "我们用Qwen3做本地识别",
      "en": "We use Qwen3 for local recognition",
      "start_ms": 70500,
      "end_ms": 72580,
      "first": 97,
      "last": 102
    },
    {
      "index": 15,
      "text": "云端用火山引擎兜底",
      "en": "With Volcano Engine as cloud fallback",
      "start_ms": 75500,
      "end_ms": 77480,
      "first": 103,
      "last": 106
    },
    {
      "index": 16,
      "text": "every cut must be frame accurate",
      "en": "Every cut must be frame accurate",
      "start_ms": 80500,
      "end_ms": 82420,
      "first": 107,
      "last": 112
    },
    {
      "index": 17,
      "text": "每一个剪点都要精确到帧",
      "en": "Each cut point accurate to the frame",
      "start_ms": 85500,
      "end_ms": 87920,
      "first": 113,
      "last": 119
    },
    {
      "index": 18,
      "text": "交接之前先看损失报告",
      "en": "Check the loss report before handoff",
      "start_ms": 90500,
      "end_ms": 92700,
      "first": 120,
      "last": 125
    },
    {
      "index": 19,
      "text": "哪些能保留哪些要重做",
      "en": "What survives and what must be redone",
      "start_ms": 95500,
      "end_ms": 97700,
      "first": 126,
      "last": 131
    },
    {
      "index": 20,
      "text": "剪辑师拿到的工程还能继续改",
      "en": "The editor can keep editing the project",
      "start_ms": 100500,
      "end_ms": 103360,
      "first": 132,
      "last": 138
    },
    {
      "index": 21,
      "text": "这才叫真正的交接",
      "en": "That is a real handoff",
      "start_ms": 105500,
      "end_ms": 107260,
      "first": 139,
      "last": 144
    },
    {
      "index": 22,
      "text": "第一期先做采访口播",
      "en": "Phase one starts with interviews",
      "start_ms": 110500,
      "end_ms": 112480,
      "first": 145,
      "last": 150
    },
    {
      "index": 23,
      "text": "谢谢大家",
      "en": "Thank you",
      "start_ms": 115500,
      "end_ms": 116380,
      "first": 151,
      "last": 152
    }
  ],
