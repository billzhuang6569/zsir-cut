{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "庄Sir剪辑助手",
  "version": "0.0.0",
  "identifier": "work.whatonearth.zsir-cut",
  "build": {
    "beforeDevCommand": "pnpm --filter @zsir-cut/desktop dev",
    "beforeBuildCommand": "pnpm --filter @zsir-cut/desktop build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../../packages/desktop/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://127.0.0.1:*; media-src 'self' http://127.0.0.1:*; connect-src 'self' ws://127.0.0.1:* http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": false
  }
}
