{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "庄Sir剪辑助手",
  "version": "0.1.0",
  "identifier": "work.whatonearth.zsir-cut",
  "build": {
    "beforeDevCommand": "pnpm --filter @zsir-cut/desktop dev",
    "beforeBuildCommand": "node ../../scripts/package-release.mjs",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../../packages/desktop/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://127.0.0.1:*; media-src 'self' http://127.0.0.1:*; connect-src 'self' ws://127.0.0.1:* http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "mainBinaryName": "zsir-cut"
}
